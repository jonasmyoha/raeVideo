pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  rae: {
    version: "0.4.29"
  }
  dependencies: {
    dep video: {
      path: "../../packages/video"
    }
    dep audio: {
      git: "https://github.com/jonasmyoha/rae.git"
      subdir: "packages/audio"
      version: "0.27.0"
      hash: "git-tree:7210fff8087c7edfa3e0a9fbb3e684a3a4726c76"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
