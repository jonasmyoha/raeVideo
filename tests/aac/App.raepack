pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  rae: {
    version: "0.4.25"
  }
  dependencies: {
    dep video: {
      path: "../../packages/video"
    }
    dep audio: {
      git: "https://github.com/jonasmyoha/rae.git"
      subdir: "packages/audio"
      version: "0.26.0"
      hash: "git-tree:26ebee8629362ede626178c5781bf5032abd7426"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
