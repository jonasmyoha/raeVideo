pack SimplePlayer {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Simple video player"
  description: "One video file in a window: the picture fitted to the window, a play/pause button and a seek bar. packages/video plays it with Rae's audio engine as the clock; the window is Rae's lib/ui."
  category: "Video"
  rae: {
    version: "0.4.3"
  }
  dependencies: {
    dep video: {
      path: "../../packages/video"
    }
    dep audio: {
      git: "https://github.com/jonasmyoha/rae.git"
      subdir: "packages/audio"
      version: "0.22.0"
      hash: "git-tree:f53afc971699c587c68f8767fd6095b81db5eed9"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
