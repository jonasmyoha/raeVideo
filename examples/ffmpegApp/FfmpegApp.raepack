pack FfmpegApp {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "FFmpeg in a shipped app"
  description: "The DNxHR test file decoded through packages/ffmpeg and shown on the GPU, by a program that tools/checkFfmpegBundle.sh puts in a macOS app with FFmpeg in its Contents/Frameworks."
  category: "Video"
  rae: {
    version: "0.4.0"
  }
  dependencies: {
    dep video: {
      path: "../../packages/video"
    }
    dep ffmpeg: {
      path: "../../packages/ffmpeg"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
