#!/usr/bin/env bash
# Refuse a commit whose STAGED changes contain a banned term
# (tools/banned-terms-gate.sh). Installed by `make install-hooks` (git does not
# version hooks). No term list on this machine -> the gate skips and the commit
# goes through. Bypass once with `git commit --no-verify` if you must.
exec bash "$(git rev-parse --show-toplevel)/tools/banned-terms-gate.sh" --staged
