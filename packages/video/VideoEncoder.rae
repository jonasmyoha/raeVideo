# video/VideoEncoder — frames in, encoded packets out (docs/design.md §5 V2,
# §6.4): H.264, HEVC and ProRes (422 Proxy, LT, 422, HQ, 4444) through
# VideoToolbox, and what a registered encoder adds (packages/ffmpeg: DNxHR LB
# and HQ, FFV1), fed from a picture on the GPU. Which backend encodes which
# codec is a Rae table (EncoderBackend), as for decoding (video/VideoBackends).
#
#     var encoder: VideoEncoder = openVideoEncoder(resources:, settings:, table:
#     defaultEncoderBackends())
#     encoder.encodeTexture(resources:, texture: picture.picture, time: frameIndex * 1001)
#     ... loop: let packets: List(EncodedPacket) = encoder.takePackets() -> a MediaWriter ...
#     encoder.finish()      # then takePackets() for the last ones
#     encoder.close(resources:)
#
# A frame goes from an RGBA texture (rgba8unorm, R'G'B' as YuvPicture gives it)
# to the encoder by a readback. For VideoToolbox a compute pass
# (rgbaToBgra.wgsl) packs it as 32-bit BGRA, the C glue copies it into an
# IOSurface-backed pixel buffer of the session's pool, and VideoToolbox converts
# to the codec's Y'CbCr with BT.709 tags. For a registered encoder the pass
# (rgbaToPlanar.wgsl) converts it to the 8-bit planar Y'CbCr it takes (BT.709,
# limited range; 4:2:2 for DNxHR, 4:2:0 for FFV1). Handing it the texture's own
# memory (an IOSurface-backed texture, no readback) would need a way to import
# one that webgpu.h does not have (docs/design.md §12 V3), and is not worth it:
# at 4K the readback's copies are about 1.5 ms a frame, and the encoder takes
# longer (checks/export4k, docs/measurements.md). The frame is read into one
# list per encoder, made once.
#
# A caller may give a different texture each frame, or alternate two (a
# compositor's two frames): the encoder makes a view and bind group for the
# texture when it is not the last one given, and retires the last one's, so
# alternating costs that remaking and nothing piles up. Handing over the same
# texture every frame makes them once.
#
# Frames are encoded in order, without reordering (no B-frames): each packet's
# decode time is its time. The packets come out on VideoToolbox's thread and
# wait in the glue until takePackets.
import Math
open gpu/GpuCompute
open gpu/GpuIds
open gpu/GpuLifetime
open gpu/GpuRenderTransfer
open gpu/GpuResources
open video/VideoBackends
open video/VideoDecoder
open video/VideoGlue
open video/YuvPicture
open webgpu/ReadRequest
open webgpu/WebgpuEnums

enum VideoCodec {
  h264
  hevc
  prores422Proxy
  prores422Lt
  prores422
  prores422Hq
  prores4444
  # a registered encoder's (packages/ffmpeg)
  dnxhrLb
  dnxhrHq
  ffv1
}

type EncoderSettings {
  codec: VideoCodec
  width: Int
  height: Int
  # times are in 1 / timescale (30000 for 29.97 fps, with frames 1001 apart)
  timescale: Int
  # bits per second (0: the codec's own); quality 1-100 (0: not set)
  bitRate: Int
  quality: Int
  # the most frames between keyframes (0: the codec's own)
  keyframeInterval: Int
}

type EncodedPacket {
  bytes: List(UInt8)
  time: Int
  decodeTime: Int
  keyframe: Bool
}

# Which backend encodes a codec: VideoToolbox, or a registered encoder (its
# number, the encoder's name and profile it is opened with)
type EncoderBackend {
  codec: VideoCodec
  kind: VideoBackend
  number: Int
  encoderName: String
  profile: String
}

type VideoEncoder {
  settings: EncoderSettings
  kind: VideoBackend
  number: Int
  handle: Int
  # what the GPU pass makes: BGRA (VideoToolbox) or 8-bit planar Y'CbCr in
  # this layout (a registered encoder)
  planar: Bool
  inputLayout: FrameLayout
  inputBytes: Int
  # the GPU side: the converted frame, its readback, the pass
  packed: BufferId
  readback: BufferId
  sizes: BufferId
  bounds: ComputeBounds
  pipeline: PipelineId
  # the texture last given (its slot, -1 for none, and generation), the view
  # made of it and the bind group: made again for another texture, the old
  # view and bind group retired with it
  textureView: TextureViewId
  bindGroup: BindGroupId
  boundTexture: Int
  boundGeneration: Int
  # the frame read back, made once (a 4K BGRA frame is 33 MB)
  pixels: List(UInt8)
  framesGiven: Int
  # the last frame's steps, in ns (checks/export4k): the GPU pass and its
  # buffer copy, waited for; mapping the readback; copying it into a list;
  # handing it to the encoder (the glue's copy into its pixel buffer)
  lastPassNs: Int
  lastMapNs: Int
  lastCopyNs: Int
  lastHandOffNs: Int
  error: String
}

# The sample entry's four characters a codec is written with
func codecFourCharacters(codec: view VideoCodec) ret String {
  if codec is VideoCodec.hevc {
    ret "hvc1"
  }
  if codec is VideoCodec.prores422Proxy {
    ret "apco"
  }
  if codec is VideoCodec.prores422Lt {
    ret "apcs"
  }
  if codec is VideoCodec.prores422 {
    ret "apcn"
  }
  if codec is VideoCodec.prores422Hq {
    ret "apch"
  }
  if codec is VideoCodec.prores4444 {
    ret "ap4h"
  }
  if codec is VideoCodec.dnxhrLb or codec is VideoCodec.dnxhrHq {
    ret "AVdh"
  }
  if codec is VideoCodec.ffv1 {
    ret "FFV1"
  }
  ret "avc1"
}

# The codecs VideoToolbox encodes
func videoToolboxEncoderCodecs() ret List(VideoCodec) {
  ret List(VideoCodec) {
    VideoCodec.h264
    VideoCodec.hevc
    VideoCodec.prores422Proxy
    VideoCodec.prores422Lt
    VideoCodec.prores422
    VideoCodec.prores422Hq
    VideoCodec.prores4444
  }
}

func defaultEncoderBackends() ret List(EncoderBackend) {
  var table: List(EncoderBackend) = {}
  if Target.isApple {
    loop let codec: VideoCodec in videoToolboxEncoderCodecs() {
      table.add(value: EncoderBackend {
        codec: codec
        kind: VideoBackend.videoToolbox
        number: 0
        encoderName: ""
        profile: ""
      })
    }
  }
  ret table
}

# Gives an encoder's C calls (a RaeVideoEncoderCalls, native/rae_video.h) to
# this package's C: its number, or 0 when they do not fit
func registerEncoder(calls: view Ptr) ret Int {
  unsafe {
    ret rae_video_encoder_register(calls: calls)
  }
}

# Puts a registered encoder in the table for `codec`, ahead of any other
func addEncoderBackend(
  this: mod List(EncoderBackend)
  codec: view VideoCodec
  number: view Int
  encoderName: view String
  profile: view String
) {
  this.insert(
    index: 0
    value: EncoderBackend {
      codec: codec
      kind: VideoBackend.registered
      number: number
      encoderName: "{encoderName}"
      profile: "{profile}"
    }
  )
}

func noVideoEncoder(settings: view EncoderSettings) ret VideoEncoder {
  ret VideoEncoder {
    settings: settings
    kind: VideoBackend.none
    number: 0
    handle: 0
    planar: false
    inputLayout: FrameLayout.unsupported
    inputBytes: 0
    packed: noBufferId()
    readback: noBufferId()
    sizes: noBufferId()
    bounds: noComputeBounds(workgroupSize: conversionWorkgroupSize)
    pipeline: noPipelineId()
    textureView: noTextureViewId()
    bindGroup: noBindGroupId()
    boundTexture: -1
    boundGeneration: -1
    pixels: {}
    framesGiven: 0
    lastPassNs: 0
    lastMapNs: 0
    lastCopyNs: 0
    lastHandOffNs: 0
    error: "no encoder for {codecFourCharacters(codec: settings.codec)} here"
  }
}

# Opens the backend for the codec: true when one opened
func openBackend(this: mod VideoEncoder, table: view List(EncoderBackend)) ret Bool {
  let settings: EncoderSettings = this.settings
  loop let backend: view EncoderBackend in table {
    if this.handle is 0 and backend.codec is settings.codec {
      unsafe {
        if backend.kind is VideoBackend.videoToolbox {
          this.handle = rae_video_vte_open(
            codec: fourCharacterCode(text: codecFourCharacters(codec: settings.codec))
            width: settings.width
            height: settings.height
            timescale: settings.timescale
            bitRate: settings.bitRate
            qualityPercent: settings.quality
            keyframeInterval: settings.keyframeInterval
          )
        } else {
          let nameZ: List(UInt8) = textBytesZ(text: backend.encoderName)
          let profileZ: List(UInt8) = textBytesZ(text: backend.profile)
          this.handle = rae_video_registered_encoder_open(
            backend: backend.number
            encoderZ: nameZ.data
            profileZ: profileZ.data
            width: settings.width
            height: settings.height
            timescale: settings.timescale
            bitRate: settings.bitRate
            keyframeInterval: settings.keyframeInterval
          )
        }
      }
      if this.handle is not 0 {
        this.kind = backend.kind
        this.number = backend.number
      }
    }
  }
  ret this.handle is not 0
}

func openVideoEncoder(
  resources: mod GpuResources
  settings: view EncoderSettings
  table: view List(EncoderBackend)
) ret VideoEncoder {
  var encoder: VideoEncoder = noVideoEncoder(settings: settings)
  if not encoder.openBackend(table: table) {
    ret encoder
  }
  encoder.error = ""
  var sizeWords: List(UInt8) = List.create(UInt8, cap: 32)
  var conversion: Shader = shader(files: ["lib/gpu/computeBounds.wgsl", "rgbaToBgra.wgsl"])
  var size: Int = settings.width * settings.height * 4
  if encoder.kind is VideoBackend.registered {
    var layoutCode: Int = 0
    unsafe {
      layoutCode = rae_video_registered_encoder_input_layout(
        backend: encoder.number
        encoder: encoder.handle
      )
    }
    encoder.planar = true
    encoder.inputLayout = layoutOfCode(code: layoutCode)
    if encoder.inputLayout is not FrameLayout.planar420 and encoder.inputLayout is not FrameLayout.planar422 {
      encoder.error = "the encoder takes a layout this package cannot make ({layoutCode})"
      ret encoder
    }
    let chromaWidth: Int = (settings.width + 1) / 2
    let rows: Int = chromaHeightDivisorOf(layout: encoder.inputLayout)
    let chromaHeight: Int = (settings.height + rows - 1) / rows
    encoder.inputBytes = settings.width * settings.height + 2 * chromaWidth * chromaHeight
    size = (encoder.inputBytes + 3) / 4 * 4
    addWord(bytes: sizeWords, word: settings.width)
    addWord(bytes: sizeWords, word: settings.height)
    addWord(bytes: sizeWords, word: chromaWidth)
    addWord(bytes: sizeWords, word: chromaHeight)
    addWord(bytes: sizeWords, word: rows)
    addWord(bytes: sizeWords, word: 0)
    addWord(bytes: sizeWords, word: 0)
    addWord(bytes: sizeWords, word: 0)
    conversion = shader(files: ["lib/gpu/computeBounds.wgsl", "rgbaToPlanar.wgsl"])
  } else {
    encoder.inputBytes = size
    addWord(bytes: sizeWords, word: settings.width)
    addWord(bytes: sizeWords, word: settings.height)
    addWord(bytes: sizeWords, word: 0)
    addWord(bytes: sizeWords, word: 0)
  }
  var made: Bool = false
  if let packed: BufferId = createBuffer(
    resources: resources
    size: size
    usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopySrc
  ) {
    if let readback: BufferId = createBuffer(
      resources: resources
      size: size
      usage: WGPUBufferUsage_MapRead + WGPUBufferUsage_CopyDst
    ) {
      if let sizes: BufferId = createBuffer(
        resources: resources
        size: sizeWords.length()
        usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
      ) {
        if let bounds: ComputeBounds = createComputeBounds(
          resources: resources
          workgroupSize: conversionWorkgroupSize
        ) {
          if let pipeline: PipelineId = createBoundedComputePipeline(
            resources: resources
            wgsl: conversion.text
            entryPoint: "main"
            bounds: bounds
          ) {
            encoder.packed = packed
            encoder.readback = readback
            encoder.sizes = sizes
            encoder.bounds = bounds
            encoder.pipeline = pipeline
            made = writeBuffer(
              resources: resources
              id: sizes
              offset: 0
              bytes: sizeWords
            )
          }
        }
      }
    }
  }
  if not made {
    encoder.error = "the GPU refused the encoder's buffers"
  }
  ret encoder
}

# The number of invocations of the pass: a pixel each (BGRA), a 4-byte word
# each (planar)
func passCount(this: view VideoEncoder) ret Int {
  if this.planar {
    ret (this.inputBytes + 3) / 4
  }
  ret this.settings.width * this.settings.height
}

# Converts the texture (rgba8unorm, the encoder's size) on the GPU, reads it
# back and gives it to the encoder as the frame shown at `time`. Waits for the
# GPU (an export runs offline).
func encodeTexture(
  this: mod VideoEncoder
  resources: mod GpuResources
  texture: view TextureId
  time: view Int
) ret Bool {
  if this.handle is 0 or this.error.length() > 0 {
    ret false
  }
  if this.boundTexture is not texture.slot or this.boundGeneration is not texture.generation {
    this.unbindTexture(resources: resources)
    if let textureView: TextureViewId = createTextureView(resources: resources, texture: texture) {
      this.textureView = textureView
      var buffers: List(BufferId) = {}
      buffers.add(value: this.sizes)
      buffers.add(value: this.packed)
      var views: List(TextureViewId) = {}
      views.add(value: textureView)
      let noSamplers: List(SamplerId) = {}
      if let bindGroup: BindGroupId = createBoundedBindGroup(
        resources: resources
        pipeline: this.pipeline
        bounds: this.bounds
        buffers: buffers
        textureViews: views
        samplers: noSamplers
      ) {
        this.bindGroup = bindGroup
        this.boundTexture = texture.slot
        this.boundGeneration = texture.generation
      } else {
        let gone: Bool = retireTextureView(resources: resources, id: textureView)
        this.textureView = noTextureViewId()
      }
    }
    if this.boundTexture < 0 {
      this.error = "the texture could not be bound"
      ret false
    }
  }
  let size: Int = (this.inputBytes + 3) / 4 * 4
  let started: Int = nowNs()
  var done: Bool = false
  if var recording: Recording = beginRecording(resources: resources) {
    let converted: Bool = recordBoundedCompute(
      recording: recording
      resources: resources
      pipeline: this.pipeline
      bindGroup: this.bindGroup
      bounds: this.bounds
      elementCount: this.passCount()
    )
    let copied: Bool = recordCopyBuffer(
      recording: recording
      resources: resources
      source: this.packed
      sourceOffset: 0
      destination: this.readback
      destinationOffset: 0
      size: size
    )
    if let submission: SubmissionId = submit(resources: resources, recording: recording) {
      done = converted and copied and awaitSubmission(resources: resources, id: submission)
    }
  }
  if not done {
    this.error = "converting frame {this.framesGiven} failed"
    ret false
  }
  let passed: Int = nowNs()
  var mapped: Int = passed
  # the list the frame is copied into is made once, here: counted with the copy
  if this.pixels.length() is not size {
    this.pixels = List.create(UInt8, cap: size)
    this.pixels.addDefaults(count: size)
  }
  let allocated: Int = nowNs()
  var read: Bool = false
  if let request: ReadRequest = readBuffer(
    resources: resources
    id: this.readback
    offset: 0
    size: size
  ) {
    var status: Int = 0
    var spins: Int = 0
    loop status is 0 and spins < 100000000 {
      status = request.poll()
      spins = spins + 1
    }
    mapped = nowNs()
    read = status is 1 and request.copyToBytes(destination: this.pixels)
  }
  if not read {
    this.error = "reading frame {this.framesGiven} back failed"
    ret false
  }
  let copied: Int = nowNs()
  var result: Int = 0
  unsafe {
    if this.kind is VideoBackend.videoToolbox {
      result = rae_video_vte_encode(
        encoder: this.handle
        bgra: this.pixels.data
        bytesPerRow: this.settings.width * 4
        time: time
      )
    } else {
      result = rae_video_registered_encoder_encode(
        backend: this.number
        encoder: this.handle
        planes: this.pixels.data
        time: time
      )
    }
  }
  if result is not 0 {
    this.error = "the encoder refused frame {this.framesGiven} ({result})"
    ret false
  }
  let handedOff: Int = nowNs()
  this.lastPassNs = passed - started
  this.lastMapNs = mapped - allocated
  this.lastCopyNs = copied - mapped + allocated - passed
  this.lastHandOffNs = handedOff - copied
  this.framesGiven = this.framesGiven + 1
  ret true
}

func waitingPackets(this: view VideoEncoder) ret Int {
  unsafe {
    if this.kind is VideoBackend.videoToolbox {
      ret rae_video_vte_packet_count(encoder: this.handle)
    }
    ret rae_video_registered_encoder_packet_count(backend: this.number, encoder: this.handle)
  }
}

func packetInfo(this: view VideoEncoder, info: mod List(Int)) ret Bool {
  unsafe {
    if this.kind is VideoBackend.videoToolbox {
      ret rae_video_vte_packet_info(encoder: this.handle, out: info.data) is 0
    }
    ret rae_video_registered_encoder_packet_info(
      backend: this.number
      encoder: this.handle
      out: info.data
    ) is 0
  }
}

func takePacketBytes(this: view VideoEncoder, bytes: mod List(UInt8), size: view Int) ret Int {
  unsafe {
    if this.kind is VideoBackend.videoToolbox {
      ret rae_video_vte_take_packet(encoder: this.handle, into: bytes.data, capacity: size)
    }
    ret rae_video_registered_encoder_take_packet(
      backend: this.number
      encoder: this.handle
      into: bytes.data
      capacity: size
    )
  }
}

# The packets encoded so far, oldest first
func takePackets(this: mod VideoEncoder) ret List(EncodedPacket) {
  var packets: List(EncodedPacket) = {}
  if this.handle is 0 {
    ret packets
  }
  var info: List(Int) = List.create(Int, cap: 4)
  info.addDefaults(count: 4)
  let waiting: Int = this.waitingPackets()
  loop var i: Int = 0, i < waiting, ++i {
    if not this.packetInfo(info: info) {
      ret packets
    }
    let size: Int = info.copyAtDefault(index: 0)
    var bytes: List(UInt8) = List.create(UInt8, cap: max(a: 1, b: size))
    bytes.addDefaults(count: size)
    if this.takePacketBytes(bytes: bytes, size: size) is size {
      packets.add(
        value: EncodedPacket {
          bytes: own bytes
          time: info.copyAtDefault(index: 1)
          decodeTime: info.copyAtDefault(index: 2)
          keyframe: info.copyAtDefault(index: 3) is 1
        }
      )
    }
  }
  ret packets
}

# Waits until every frame given has come out (then takePackets)
func finish(this: mod VideoEncoder) ret Bool {
  if this.handle is 0 {
    ret false
  }
  unsafe {
    if this.kind is VideoBackend.videoToolbox {
      ret rae_video_vte_finish(encoder: this.handle) is 0 and rae_video_vte_failures(
        encoder: this.handle
      ) is 0
    }
    ret rae_video_registered_encoder_finish(backend: this.number, encoder: this.handle) is 0
  }
}

# The codec configuration the sample entry needs (avcC / hvcC payload, FFV1's
# extradata; empty for ProRes and DNxHR), known once a packet has come out,
# and the box it goes in (`configKindOf`)
func codecConfig(this: view VideoEncoder) ret List(UInt8) {
  var info: List(Int) = List.create(Int, cap: 1)
  info.addDefaults(count: 1)
  var size: Int = 0
  unsafe {
    if this.kind is VideoBackend.videoToolbox {
      size = rae_video_vte_config_size(encoder: this.handle, out: info.data)
    } else {
      size = rae_video_registered_encoder_config_size(
        backend: this.number
        encoder: this.handle
        out: info.data
      )
    }
  }
  var bytes: List(UInt8) = List.create(UInt8, cap: max(a: 1, b: size))
  if size > 0 {
    bytes.addDefaults(count: size)
    unsafe {
      if this.kind is VideoBackend.videoToolbox {
        let copied: Int = rae_video_vte_copy_config(
          encoder: this.handle
          into: bytes.data
          capacity: size
        )
      } else {
        let copied: Int = rae_video_registered_encoder_copy_config(
          backend: this.number
          encoder: this.handle
          into: bytes.data
          capacity: size
        )
      }
    }
  }
  ret bytes
}

func close(this: mod VideoEncoder, resources: mod GpuResources) {
  if this.handle is not 0 {
    unsafe {
      if this.kind is VideoBackend.videoToolbox {
        rae_video_vte_close(encoder: this.handle)
      } else {
        rae_video_registered_encoder_close(backend: this.number, encoder: this.handle)
      }
    }
    this.handle = 0
  }
  this.unbindTexture(resources: resources)
}

# Retires the view and bind group of the texture last given (the GPU manager
# frees them once the work submitted with them is done)
func unbindTexture(this: mod VideoEncoder, resources: mod GpuResources) {
  if this.boundTexture >= 0 {
    let groupGone: Bool = retireBindGroup(resources: resources, id: this.bindGroup)
    let viewGone: Bool = retireTextureView(resources: resources, id: this.textureView)
    this.bindGroup = noBindGroupId()
    this.textureView = noTextureViewId()
    this.boundTexture = -1
    this.boundGeneration = -1
  }
}
