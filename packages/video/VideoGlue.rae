func rae_video_frame_transfer(frame: Int) unsafe extern("rae_video_frame_transfer") ret Int

func rae_video_frame_release(frame: Int) unsafe extern("rae_video_frame_release")

# A text's bytes with a zero after them, for a C path
func textBytesZ(text: view String) ret List(UInt8) {
  var bytes: List(UInt8) = List.create(UInt8, cap: text.length() + 1)
  loop var i: Int = 0, i < text.length(), ++i {
    bytes.add(value: text.byteAt(index: i) as UInt8)
  }
  bytes.add(value: 0 as UInt8)
  ret bytes
}

# Four characters ("avc1") as the big-endian integer C's four-character codes are
func fourCharacterCode(text: view String) ret Int {
  var code: Int = 0
  loop var i: Int = 0, i < 4, ++i {
    var byte: Int = 32
    if i < text.length() {
      byte = text.byteAt(index: i)
    }
    code = code * 256 + byte
  }
  ret code
}
