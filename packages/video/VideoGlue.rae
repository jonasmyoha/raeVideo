cheader "rae_video.h"

# The bindings to native/rae_video_glue.c (docs/design.md §5 V1): files, and
# VideoToolbox decoding on Apple, one platform call each. Handles are Int (0:
# none). A program that imports this links the package's C (native/build.sh).
func rae_video_file_open(pathZ: Buffer(UInt8)) unsafe extern("rae_video_file_open") ret Int

func rae_video_file_size(file: Int) unsafe extern("rae_video_file_size") ret Int

func rae_video_file_read_at(
  file: Int
  into: Buffer(UInt8)
  count: Int
  offset: Int
) unsafe extern("rae_video_file_read_at") ret Int

func rae_video_file_close(file: Int) unsafe extern("rae_video_file_close")

func rae_video_vt_available() unsafe extern("rae_video_vt_available") ret Int

func rae_video_vt_open(
  codec: Int
  width: Int
  height: Int
  config: Buffer(UInt8)
  configSize: Int
  configKind: Int
) unsafe extern("rae_video_vt_open") ret Int

func rae_video_vt_decode(
  decoder: Int
  packet: Buffer(UInt8)
  size: Int
  time: Int
  timescale: Int
) unsafe extern("rae_video_vt_decode") ret Int

func rae_video_vt_close(decoder: Int) unsafe extern("rae_video_vt_close")

func rae_video_frame_width(frame: Int) unsafe extern("rae_video_frame_width") ret Int

func rae_video_frame_height(frame: Int) unsafe extern("rae_video_frame_height") ret Int

func rae_video_frame_pixel_format(frame: Int) unsafe extern("rae_video_frame_pixel_format") ret Int

func rae_video_frame_plane_count(frame: Int) unsafe extern("rae_video_frame_plane_count") ret Int

func rae_video_frame_plane_width(
  frame: Int
  plane: Int
) unsafe extern("rae_video_frame_plane_width") ret Int

func rae_video_frame_plane_height(
  frame: Int
  plane: Int
) unsafe extern("rae_video_frame_plane_height") ret Int

func rae_video_frame_plane_bytes_per_row(
  frame: Int
  plane: Int
) unsafe extern("rae_video_frame_plane_bytes_per_row") ret Int

func rae_video_frame_lock(frame: Int) unsafe extern("rae_video_frame_lock") ret Int

func rae_video_frame_plane_address(
  frame: Int
  plane: Int
) unsafe extern("rae_video_frame_plane_address") ret Ptr

func rae_video_frame_unlock(frame: Int) unsafe extern("rae_video_frame_unlock")

func rae_video_frame_copy_plane(
  frame: Int
  plane: Int
  into: Buffer(UInt8)
