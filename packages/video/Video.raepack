pack Video {
  format: "raepack"
  version: 1
  meta: {
    version: "0.14.0"
  }
  rae: {
    version: "0.4.29"
  }
  dependencies: {
    dep audio: {
      git: "https://github.com/jonasmyoha/rae.git"
      subdir: "packages/audio"
      version: "0.27.0"
      hash: "git-tree:7210fff8087c7edfa3e0a9fbb3e684a3a4726c76"
    }
  }
  native: {
    build: "native/build.sh"
    header: "rae_video.h"
    include: "include"
    link: "lib/libraevideo.a"
  }
}
