pack Video {
  format: "raepack"
  version: 1
  meta: {
    version: "0.12.0"
  }
  rae: {
    version: "0.4.3"
  }
  dependencies: {
    dep audio: {
      git: "https://github.com/jonasmyoha/rae.git"
      subdir: "packages/audio"
      version: "0.22.0"
      hash: "git-tree:f53afc971699c587c68f8767fd6095b81db5eed9"
    }
  }
  native: {
    build: "native/build.sh"
    header: "rae_video.h"
    include: "include"
    link: "lib/libraevideo.a"
  }
}
