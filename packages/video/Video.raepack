pack Video {
  format: "raepack"
  version: 1
  meta: {
    version: "0.12.1"
  }
  rae: {
    version: "0.4.24"
  }
  dependencies: {
    dep audio: {
      git: "https://github.com/jonasmyoha/rae.git"
      subdir: "packages/audio"
      version: "0.25.0"
      hash: "git-tree:dd7ed0543fe1db9baa0a5f6648da6b390c570199"
    }
  }
  native: {
    build: "native/build.sh"
    header: "rae_video.h"
    include: "include"
    link: "lib/libraevideo.a"
  }
}
