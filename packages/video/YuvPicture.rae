# video/YuvPicture — a decoded frame on the GPU as an RGBA texture (docs/design.md
# §7, the copy path): the frame's planes are copied from the decoder's memory
# into textures by the queue (NV12: r8unorm Y and rg8unorm CbCr; three planes:
# r8unorm each), and a compute pass (yuvToRgb.wgsl, or yuvPlanarToRgb.wgsl)
# converts them into `picture` (rgba8unorm) with the matrix and range the
# frame is tagged with. The CPU does not touch the pixels: the one copy is the
# queue's upload from the frame's memory.
#
#     if var picture: YuvPicture = createYuvPicture(resources: resources, width: 1920, height:
#     1080, layout: FrameLayout.nv12) {
#       if picture.uploadFrame(resources: resources, frame: frame) {
#         ... picture.recordConversion(recording: recording, resources: resources) ...
#         ... draw picture.pictureView ...
#       }
#     }
#
# A frame of another size or layout needs another picture (createYuvPicture).
import Math
open gpu/GpuCompute
open gpu/GpuIds
open gpu/GpuLifetime
open gpu/GpuRenderTransfer
open gpu/GpuResources
open gpu/GpuTextures
open video/VideoDecoder
open video/VideoGlue
open webgpu/Context
open webgpu/ReadRequest
open webgpu/Webgpu
open webgpu/WebgpuEnums
open webgpu/WebgpuTypes

# Invocations per workgroup: a 4K frame (8.3 million pixels) fits one
# dimension's 65 535 workgroups at 256
const conversionWorkgroupSize: Int = 256

type YuvPicture {
  width: Int
  height: Int
  layout: FrameLayout
  # one texture per plane of the layout, and their views
  planes: List(TextureId)
  planeViews: List(TextureViewId)
  # the converted frame: rgba8unorm, R'G'B' in the stream's transfer
  picture: TextureId
  pictureView: TextureViewId
  parameters: BufferId
  bounds: ComputeBounds
  pipeline: PipelineId
  bindGroup: BindGroupId
  # the frame last uploaded (its sample index), -1 for none
  uploadedSample: Int
}

# The coefficients of the R'G'B' equations for a matrix's Kr and Kb
type YuvCoefficients {
  crToRed: Float
  cbToGreen: Float
  crToGreen: Float
  cbToBlue: Float
}

func coefficientsOf(red: view Float, blue: view Float) ret YuvCoefficients {
  let green: Float = 1.0 - red - blue
  ret YuvCoefficients {
    crToRed: 2.0 * (1.0 - red)
    cbToGreen: 2.0 * blue * (1.0 - blue) / green
    crToGreen: 2.0 * red * (1.0 - red) / green
    cbToBlue: 2.0 * (1.0 - blue)
  }
}

# The matrix a frame is converted with: its tag, or for an untagged frame the
# usual guess (docs/design.md §7): BT.709 from 720 lines up, else BT.601
func effectiveMatrix(frame: view VideoFrame) ret YuvMatrix {
  if frame.matrix is not YuvMatrix.unknown {
    ret frame.matrix
  }
  if frame.height >= 720 {
    ret YuvMatrix.bt709
  }
  ret YuvMatrix.bt601
}

func matrixCoefficients(matrix: view YuvMatrix) ret YuvCoefficients {
  if matrix is YuvMatrix.bt601 {
    ret coefficientsOf(red: 0.299, blue: 0.114)
  }
  if matrix is YuvMatrix.bt2020 {
    ret coefficientsOf(red: 0.2627, blue: 0.0593)
  }
  if matrix is YuvMatrix.smpte240 {
    ret coefficientsOf(red: 0.212, blue: 0.087)
  }
  ret coefficientsOf(red: 0.2126, blue: 0.0722)
}

func addWord(bytes: mod List(UInt8), word: view Int) {
  loop var i: Int = 0, i < 4, ++i {
    bytes.add(value: ((word shr (i * 8)) bitand 255) as UInt8)
  }
}

func addFloat(bytes: mod List(UInt8), value: view Float) {
  addWord(bytes: bytes, word: floatBits(value: value))
}

# The YuvParameters uniform of yuvToRgb.wgsl / yuvPlanarToRgb.wgsl for a frame
# converted with `matrix` (48 bytes)
func parameterBytes(
  matrix: view YuvMatrix
  fullRange: view Bool
  width: view Int
  height: view Int
  layout: view FrameLayout
) ret List(UInt8) {
  var bytes: List(UInt8) = List.create(UInt8, cap: 48)
  if fullRange {
    addFloat(bytes: bytes, value: 0.0)
    addFloat(bytes: bytes, value: 1.0)
    addFloat(bytes: bytes, value: 128.0 / 255.0)
    addFloat(bytes: bytes, value: 1.0)
  } else {
    addFloat(bytes: bytes, value: 16.0 / 255.0)
    addFloat(bytes: bytes, value: 255.0 / 219.0)
    addFloat(bytes: bytes, value: 128.0 / 255.0)
    addFloat(bytes: bytes, value: 255.0 / 224.0)
  }
  let coefficients: YuvCoefficients = matrixCoefficients(matrix: matrix)
  addFloat(bytes: bytes, value: coefficients.crToRed)
  addFloat(bytes: bytes, value: coefficients.cbToGreen)
  addFloat(bytes: bytes, value: coefficients.crToGreen)
  addFloat(bytes: bytes, value: coefficients.cbToBlue)
  addWord(bytes: bytes, word: width)
  addWord(bytes: bytes, word: height)
  addWord(bytes: bytes, word: chromaWidthDivisorOf(layout: layout))
  addWord(bytes: bytes, word: chromaHeightDivisorOf(layout: layout))
  ret bytes
}

func createPlaneTexture(
  resources: mod GpuResources
  width: view Int
  height: view Int
  format: view Int32
) ret opt TextureId {
  ret createTexture(
    resources: resources
    width: width
    height: height
    format: format
    usage: WGPUTextureUsage_TextureBinding + WGPUTextureUsage_CopyDst
  )
}

# The conversion shader for a layout
func conversionShader(layout: view FrameLayout) ret Shader {
  if layout is FrameLayout.nv12 {
    ret shader(files: ["lib/gpu/computeBounds.wgsl", "yuvToRgb.wgsl"])
  }
  ret shader(files: ["lib/gpu/computeBounds.wgsl", "yuvPlanarToRgb.wgsl"])
}

# The textures, the parameters and the conversion pipeline for frames of
# width x height in `layout`; none when the layout cannot be shown or the GPU
# refuses one of them
func createYuvPicture(
  resources: mod GpuResources
  width: view Int
  height: view Int
  layout: view FrameLayout
) ret opt YuvPicture {
  let count: Int = planeCountOf(layout: layout)
  if count is 0 {
    ret none
  }
  let chromaWidth: Int = (width + chromaWidthDivisorOf(layout: layout) - 1) / chromaWidthDivisorOf(
    layout: layout
  )
  let chromaHeight: Int = (height + chromaHeightDivisorOf(layout: layout) - 1) / chromaHeightDivisorOf(
    layout: layout
  )
  var planes: List(TextureId) = {}
  var views: List(TextureViewId) = {}
  loop var plane: Int = 0, plane < count, ++plane {
    var planeWidth: Int = width
    var planeHeight: Int = height
    var format: Int32 = WGPUTextureFormat_R8Unorm
    if plane > 0 {
      planeWidth = chromaWidth
      planeHeight = chromaHeight
      if layout is FrameLayout.nv12 {
        format = WGPUTextureFormat_RG8Unorm
      }
    }
    if let texture: TextureId = createPlaneTexture(
      resources: resources
      width: planeWidth
      height: planeHeight
      format: format
    ) {
      planes.add(value: texture)
      if let planeView: TextureViewId = createTextureView(resources: resources, texture: texture) {
        views.add(value: planeView)
      } else {
        ret none
      }
    } else {
      ret none
    }
  }
  if let picture: TextureId = createTexture(
    resources: resources
    width: width
    height: height
    format: WGPUTextureFormat_RGBA8Unorm
    usage: WGPUTextureUsage_StorageBinding + WGPUTextureUsage_TextureBinding + WGPUTextureUsage_CopySrc
  ) {
    if let pictureView: TextureViewId = createTextureView(resources: resources, texture: picture) {
      if let parameters: BufferId = createBuffer(
        resources: resources
        size: 48
        usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
      ) {
        if let bounds: ComputeBounds = createComputeBounds(
          resources: resources
          workgroupSize: conversionWorkgroupSize
        ) {
          let conversion: Shader = conversionShader(layout: layout)
          if let pipeline: PipelineId = createBoundedComputePipeline(
            resources: resources
            wgsl: conversion.text
            entryPoint: "main"
            bounds: bounds
          ) {
            var buffers: List(BufferId) = {}
            buffers.add(value: parameters)
            var bound: List(TextureViewId) = {}
            loop let planeView: TextureViewId in views {
              bound.add(value: planeView)
            }
            bound.add(value: pictureView)
            let noSamplers: List(SamplerId) = {}
            if let bindGroup: BindGroupId = createBoundedBindGroup(
              resources: resources
              pipeline: pipeline
              bounds: bounds
              buffers: buffers
              textureViews: bound
              samplers: noSamplers
            ) {
              ret YuvPicture {
                width: width
                height: height
                layout: layout
                planes: planes
                planeViews: views
                picture: picture
                pictureView: pictureView
                parameters: parameters
                bounds: bounds
                pipeline: pipeline
                bindGroup: bindGroup
                uploadedSample: -1
              }
            }
          }
        }
      }
    }
  }
  ret none
}

# Copies one plane from the frame's memory (locked) into its texture through
# the queue
func writePlane(
  resources: view GpuResources
  texture: view TextureId
  frame: view VideoFrame
  plane: view Int
) ret Bool {
  let rowBytes: Int = frame.planeBytesPerRow(plane: plane)
  let rows: Int = frame.planeHeight(plane: plane)
  let columns: Int = frame.planeWidth(plane: plane)
  if rowBytes < columns * frame.planePixelBytes(plane: plane) {
    ret false
  }
  unsafe {
    let address: Ptr = frame.planeAddress(plane: plane)
    if address is webgpuNull() {
      ret false
    }
    let destination: WGPUTexelCopyTextureInfo = {
      texture: textureHandle(resources: resources, id: texture)
      aspect: WGPUTextureAspect_All
    }
    let layout: WGPUTexelCopyBufferLayout = {
      bytesPerRow: rowBytes as UInt32
      rowsPerImage: rows as UInt32
    }
    let extent: WGPUExtent3D = {
      width: columns as UInt32
      height: rows as UInt32
      depthOrArrayLayers: 1
    }
    wgpuQueueWriteTexture(
      queue: webgpuQueue()
      destination: destination
      data: address
      dataSize: (rowBytes * rows) as UInt64
      dataLayout: layout
      writeSize: extent
    )
  }
  ret true
}

# Uploads the frame's planes and the parameters its tags give. False when the
# frame is not of this picture's size and layout.
func uploadFrame(
  this: mod YuvPicture
  resources: mod GpuResources
  frame: view VideoFrame
) ret Bool {
  if frame.handle is 0 or frame.width is not this.width or frame.height is not this.height {
    ret false
  }
  if frame.layout is not this.layout or frame.bitDepth is not 8 {
    ret false
  }
  if not frame.lockPlanes() {
    ret false
  }
  var written: Bool = true
  loop var plane: Int = 0, plane < this.planes.length(), ++plane {
    if let texture: TextureId = this.planes.copyAt(index: plane) {
      written = written and writePlane(
        resources: resources
        texture: texture
        frame: frame
        plane: plane
      )
    }
  }
  frame.unlockPlanes()
  if not written {
    ret false
  }
  if not writeBuffer(
    resources: resources
    id: this.parameters
    offset: 0
    bytes: parameterBytes(
      matrix: effectiveMatrix(frame: frame)
      fullRange: frame.fullRange
      width: this.width
      height: this.height
      layout: this.layout
    )
  ) {
    ret false
  }
  this.uploadedSample = frame.sampleIndex
  ret true
}

# Records the conversion of the uploaded planes into `picture`
func recordConversion(
  this: view YuvPicture
  recording: mod Recording
  resources: view GpuResources
) ret Bool {
  ret recordBoundedCompute(
    recording: recording
    resources: resources
    pipeline: this.pipeline
    bindGroup: this.bindGroup
    bounds: this.bounds
    elementCount: this.width * this.height
  )
}

func awaitSubmission(resources: mod GpuResources, id: view SubmissionId) ret Bool {
  var status: Int = 0
  var spins: Int = 0
  loop status is 0 and spins < 100000000 {
    status = pollSubmission(resources: resources, id: id)
    spins = spins + 1
  }
  retireSubmission(resources: resources, id: id)
  ret status is 1
}

# Converts the uploaded planes now and waits for the GPU: for tests and
# measurements (a renderer records the conversion into its own frame)
func convertNow(this: view YuvPicture, resources: mod GpuResources) ret Bool {
  if var recording: Recording = beginRecording(resources: resources) {
    if not this.recordConversion(recording: recording, resources: resources) {
      ret false
    }
    if let submission: SubmissionId = submit(resources: resources, recording: recording) {
      ret awaitSubmission(resources: resources, id: submission)
    }
  }
  ret false
}

# An RGBA8 texture's bytes, rows packed (width x 4 each), read back from the
# GPU (waited for): for tests
func readTexture(
  resources: mod GpuResources
  texture: view TextureId
  width: view Int
  height: view Int
) ret List(UInt8) {
  ret readTextureBytes(
    resources: resources
    texture: texture
    width: width
    height: height
    texelBytes: 4
  )
}

# A texture's bytes, rows packed (width x texelBytes each: 8 for rgba16float),
# read back from the GPU (waited for)
func readTextureBytes(
  resources: mod GpuResources
  texture: view TextureId
  width: view Int
  height: view Int
  texelBytes: view Int
) ret List(UInt8) {
  var pixels: List(UInt8) = List.create(UInt8, cap: width * height * texelBytes)
  let rowBytes: Int = (width * texelBytes + 255) / 256 * 256
  if let buffer: BufferId = createBuffer(
    resources: resources
    size: rowBytes * height
    usage: WGPUBufferUsage_MapRead + WGPUBufferUsage_CopyDst
  ) {
    var copied: Bool = false
    if var recording: Recording = beginRecording(resources: resources) {
      if recordCopyTextureToBuffer(
        recording: recording
        resources: resources
        texture: texture
        buffer: buffer
        bytesPerRow: rowBytes
      ) {
        if let submission: SubmissionId = submit(resources: resources, recording: recording) {
          copied = awaitSubmission(resources: resources, id: submission)
        }
      }
    }
    if copied {
      if let request: ReadRequest = readBuffer(
        resources: resources
        id: buffer
        offset: 0
        size: rowBytes * height
      ) {
        var status: Int = 0
        var spins: Int = 0
        loop status is 0 and spins < 100000000 {
          status = request.poll()
          spins = spins + 1
        }
        if status is 1 {
          var rows: List(UInt8) = List.create(UInt8, cap: rowBytes * height)
          rows.addDefaults(count: rowBytes * height)
          if request.copyToBytes(destination: rows) {
            loop var y: Int = 0, y < height, ++y {
              loop var i: Int = 0, i < width * texelBytes, ++i {
                pixels.add(value: rows.copyAtDefault(index: y * rowBytes + i))
              }
            }
          }
        }
      }
    }
    retireBuffer(resources: resources, id: buffer)
  }
  ret pixels
}

# The picture's RGBA bytes, rows packed (width x 4 each): for tests
func readPicture(this: view YuvPicture, resources: mod GpuResources) ret List(UInt8) {
  ret readTexture(
    resources: resources
    texture: this.picture
    width: this.width
    height: this.height
  )
}
