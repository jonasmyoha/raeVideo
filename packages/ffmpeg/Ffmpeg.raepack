pack Ffmpeg {
  format: "raepack"
  version: 1
  meta: {
    version: "0.4.0"
  }
  rae: {
    version: "0.3.123"
  }
  dependencies: {
    dep video: {
      git: "https://github.com/jonasmyoha/raeVideo.git"
      subdir: "packages/video"
      version: "0.7.0"
      hash: "git-tree:b9478290dd1f6ce129d02a38140b00cb832eda61"
    }
  }
  native: {
    build: "native/build.sh"
    header: "rae_ffmpeg.h"
    include: "include"
    link: "lib/libraeffmpeg.a"
  }
}
