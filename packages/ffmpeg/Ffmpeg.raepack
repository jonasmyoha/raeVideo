pack Ffmpeg {
  format: "raepack"
  version: 1
  meta: {
    version: "0.6.1"
  }
  rae: {
    version: "0.4.24"
  }
  dependencies: {
    dep video: {
      git: "https://github.com/jonasmyoha/raeVideo.git"
      subdir: "packages/video"
      version: "0.12.1"
      hash: "git-tree:fb86d54785de49792ddae14ef237857eb3575fbf"
    }
  }
  native: {
    build: "native/build.sh"
    header: "rae_ffmpeg.h"
    include: "include"
    link: "lib/libraeffmpeg.a"
  }
}
