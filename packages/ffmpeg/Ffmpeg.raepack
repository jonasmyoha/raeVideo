pack Ffmpeg {
  format: "raepack"
  version: 1
  meta: {
    version: "0.6.0"
  }
  rae: {
    version: "0.4.3"
  }
  dependencies: {
    dep video: {
      git: "https://github.com/jonasmyoha/raeVideo.git"
      subdir: "packages/video"
      version: "0.12.0"
      hash: "git-tree:733f9814122f1d8e3ad9c674fc161ab02eb36e32"
    }
  }
  native: {
    build: "native/build.sh"
    header: "rae_ffmpeg.h"
    include: "include"
    link: "lib/libraeffmpeg.a"
  }
}
