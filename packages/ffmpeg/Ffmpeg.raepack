pack Ffmpeg {
  format: "raepack"
  version: 1
  meta: {
    version: "0.8.0"
  }
  rae: {
    version: "0.4.25"
  }
  dependencies: {
    dep video: {
      git: "https://github.com/jonasmyoha/raeVideo.git"
      subdir: "packages/video"
      version: "0.14.0"
      hash: "git-tree:14551495ecf7e9250911ac75bf752a645a10209f"
    }
  }
  native: {
    build: "native/build.sh"
    header: "rae_ffmpeg.h"
    include: "include"
    link: "lib/libraeffmpeg.a"
  }
}
