pack Ffmpeg {
  format: "raepack"
  version: 1
  meta: {
    version: "0.7.0"
  }
  rae: {
    version: "0.4.24"
  }
  dependencies: {
    dep video: {
      git: "https://github.com/jonasmyoha/raeVideo.git"
      subdir: "packages/video"
      version: "0.13.0"
      hash: "git-tree:00d6cea57d79b5b5d16d34d2e4e5ac99ea458608"
    }
  }
  native: {
    build: "native/build.sh"
    header: "rae_ffmpeg.h"
    include: "include"
    link: "lib/libraeffmpeg.a"
  }
}
