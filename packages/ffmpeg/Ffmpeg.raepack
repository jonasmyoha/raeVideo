pack Ffmpeg {
  format: "raepack"
  version: 1
  meta: {
    version: "0.9.0"
  }
  rae: {
    version: "0.4.29"
  }
  dependencies: {
    dep video: {
      git: "https://github.com/jonasmyoha/raeVideo.git"
      subdir: "packages/video"
      version: "0.15.0"
      hash: "git-tree:ff1f416bc9ba96faa9ca9f1276cfae1eddafcfb3"
    }
  }
  native: {
    build: "native/build.sh"
    header: "rae_ffmpeg.h"
    include: "include"
    link: "lib/libraeffmpeg.a"
  }
}
