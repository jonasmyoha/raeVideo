pack Ffmpeg {
  format: "raepack"
  version: 1
  meta: {
    version: "0.5.0"
  }
  rae: {
    version: "0.3.171"
  }
  dependencies: {
    dep video: {
      git: "https://github.com/jonasmyoha/raeVideo.git"
      subdir: "packages/video"
      version: "0.11.0"
      hash: "git-tree:ac7718208d8920bb0ca8f59295ffe2ec7c958979"
    }
  }
  native: {
    build: "native/build.sh"
    header: "rae_ffmpeg.h"
    include: "include"
    link: "lib/libraeffmpeg.a"
  }
}
