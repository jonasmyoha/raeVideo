cheader "rae_ffmpeg.h"

# The bindings to native/rae_ffmpeg_glue.c (docs/design.md §4): FFmpeg loaded at
# run time, and its decoders as a backend of the video package. A program that
# imports this builds the package's C (native/build.sh, which builds FFmpeg).
func rae_ffmpeg_available() unsafe extern("rae_ffmpeg_available") ret Int

func rae_ffmpeg_backend_calls() unsafe extern("rae_ffmpeg_backend_calls") ret Ptr

func rae_ffmpeg_text(
  which: Int
  into: Buffer(UInt8)
  capacity: Int
) unsafe extern("rae_ffmpeg_text") ret Int
