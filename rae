#!/bin/sh
# Runs the Rae this project pins (docs/toolchain-and-packages-decision.md in Rae).
# Generated by `rae toolchain`: do not edit. RAE_ROOT=<a Rae checkout> uses that one.
set -eu
tool="0.3.123"
url="https://github.com/jonasmyoha/rae.git"
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
home=${RAE_HOME:-$HOME/.rae}
[ -z "${RAE_ROOT:-}" ] || exec "$RAE_ROOT/compiler/bin/rae" "$@"
name=
[ "${1:-}" = toolchain ] || name=$(find "$here" -maxdepth 3 -name '*.raepack' -not -path '*/.rae/*' | sort |
  while IFS= read -r pack; do
    grep -q 'targets:' "$pack" || continue
    pin=$(awk '/^[ \t]*rae:[ \t]*\{/ {on=1} on {print} on && /\}/ {exit}' "$pack")
    [ -n "$pin" ] || continue
    commit=$(echo "$pin" | sed -n 's/.*commit: *"\([^"]*\)".*/\1/p')
    echo "$pin" | sed -n 's/.*version: *"\([^"]*\)".*/\1/p' | sed "s/$/${commit:+-$commit}/"
    break
  done)
name=${name:-$tool}
if [ ! -f "$home/toolchains/$name/.ready" ]; then
  saved=$(cat "$home/source" 2>/dev/null || true)
  [ -e "$saved" ] || saved=$url
  source=${RAE_SOURCE:-$saved}
  mkdir -p "$home"
  n=0; until mkdir "$home/repo.lock" 2>/dev/null; do
    n=$((n + 1)); [ $n -lt 300 ] || { echo "rae: remove $home/repo.lock if nothing runs" >&2; exit 1; }; sleep 1
  done
  trap 'rmdir "$home/repo.lock"' EXIT
  [ -d "$home/repo/.git" ] || git clone --quiet --no-checkout "$source" "$home/repo"
  git -C "$home/repo" fetch --quiet --tags --force "$source" '+refs/heads/*:refs/remotes/source/*' || true
  rmdir "$home/repo.lock"; trap - EXIT
  ref=refs/tags/v$tool
  case $tool in *-*) ref=${tool#*-} ;; esac
  git -C "$home/repo" show "$ref:tools/toolchain-prepare.sh" | sh -s -- "$home" "$source" "$name"
fi
grep -Fqx "$here" "$home/projects" 2>/dev/null || echo "$here" >> "$home/projects"
[ "${1:-}" = toolchain ] || [ ! -f "$home/toolchains/$name/.deps" ] || . "$home/toolchains/$name/.deps"
exec "$home/toolchains/$name/compiler/bin/rae" "$@"
